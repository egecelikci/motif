{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true
  },
  "tasks": {
    "gen": "deno run --allow-read=spec --allow-write=forgejo,navidrome,website gen/main.ts",
    "check": "deno run --allow-read=spec,forgejo,navidrome,website gen/main.ts --check",
    "test": "deno test --allow-read=spec,forgejo,navidrome,website",
    "lint": "deno lint",
    "doc": "deno doc --lint gen/*.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "ci": "deno ci && deno task fmt:check && deno task lint && deno task doc && deno task test && deno task check"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "test": {
    "include": [
      "gen/"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
